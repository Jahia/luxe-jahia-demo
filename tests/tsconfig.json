{
	"include": [
		"node_modules/cypress",
		"cypress/**/*.ts"
	],
	"compilerOptions": {
		"target": "es2019",
		"lib": ["es2019", "dom"],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noImplicitAny": false,
		"types": [
			"@jahia/cypress",
			"cypress-wait-until"
		]
	},
}
