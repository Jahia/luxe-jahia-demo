{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"ignorePaths": ["**/node_modules/**"],
	"labels": ["dependencies"],
	"packageRules": [
		{
			"matchPackagePatterns": [".*"],
			"enabled": false
		},
		{
			"matchPackagePatterns": ["@jahia/.*"],
			"enabled": true
		}
	]
}
